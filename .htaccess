# Apache config for the static site (ignored by nginx — see README for the nginx equivalent).
# Everything in static/ is copied verbatim into the root of the build.

ErrorDocument 404 /404.html
DirectoryIndex index.html

# The release folder is a git checkout: never serve the repository metadata.
RedirectMatch 404 /\.git

# Old WordPress URLs
RedirectMatch 301 ^/feed/?$ /feed.xml
RedirectMatch 301 ^/comments/feed/?$ /feed.xml
RedirectMatch 301 ^/(wp-admin|wp-login\.php|xmlrpc\.php).*$ /

<IfModule mod_mime.c>
  AddType application/rss+xml .xml
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 10 minutes"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
